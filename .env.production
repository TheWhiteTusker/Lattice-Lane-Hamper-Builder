# Committed on purpose. These two values are public by definition: Next inlines
# every NEXT_PUBLIC_ variable into the browser bundle, so both are already
# readable in the HTML of every page on the live site. The thing protecting the
# data is row level security, not the secrecy of this key.
#
# They live here because the alternative — retyping them into a dashboard field
# for each deploy target — took the site down three times. A build variable set
# in the real environment still wins over this file, so a hosting platform can
# override it; this is the floor, not a lock.
#
# Rotating the anon key means editing this file. Real secrets never belong here
# — they go in .env.tooling, which Next does not read. See .env.local.example.
NEXT_PUBLIC_SUPABASE_URL=https://hoftbldhndnngjfjsqhs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nyBnj9JsHTZM1mEsKJSdcQ_TrYkXNN2
