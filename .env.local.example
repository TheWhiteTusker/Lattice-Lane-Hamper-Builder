# Three files, deliberately:
#
#   .env.production - COMMITTED. The two NEXT_PUBLIC_ values, so every build has
#                     them without anyone configuring a dashboard.
#   .env            - read by Next and COMPILED INTO the bundle, including the
#                     deployed Worker. Local overrides only; safe-to-publish
#                     values only.
#   .env.tooling    - never read by Next. Local scripts only. Secrets go here.
#
# The last two are gitignored. This example file is NOT, so never put real keys
# here.

# ---------------------------------------------------------------
# REQUIRED — the app will not start without these
# ---------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
#
# These two are compiled into the browser bundle at BUILD time, not read at
# runtime. They are committed in .env.production so every build gets them; set
# them here only to point a local checkout at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# .env.tooling — local tooling only, NEVER read by Next
# ---------------------------------------------------------------
# Supabase personal access token: https://supabase.com/dashboard/account/tokens
# Used by scripts/apply-migrations.mjs and scripts/sql.mjs. The publishable key
# above is RLS-scoped and cannot create tables, which is why this is separate.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare API token: dashboard -> My Profile -> API Tokens -> Create Token
# -> use the "Edit Cloudflare Workers" template.
# Lets `wrangler deploy` run from this machine instead of only through the
# Workers Builds pipeline. Starts with neither a fixed prefix nor a length you
# can rely on — paste it exactly as Cloudflare shows it, once; it is not
# retrievable afterwards.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Account id, shown on the right of any Workers & Pages page in the dashboard.
# Only needed if the token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=your-account-id

# ---------------------------------------------------------------
# R2 — not used by anything yet
# ---------------------------------------------------------------
# S3-compatible credentials from R2 -> Manage R2 API Tokens. Nothing in this
# app reads them today; they are here so the names are settled if we add
# object storage later (stored quotation PDFs would be the obvious use).
#
# Note these are for reaching R2 from OUTSIDE the Worker — a local script, a
# backup job, an S3 client. Code running IN the Worker should never use them:
# a bucket is attached as a binding in wrangler.jsonc and read as env.BUCKET,
# with no keys involved and nothing secret to leak. Same for the OpenNext
# incremental cache, which takes a binding rather than S3 credentials.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
