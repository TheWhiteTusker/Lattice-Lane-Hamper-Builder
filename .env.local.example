# Two files, deliberately:
#
#   .env.production - COMMITTED. The two NEXT_PUBLIC_ values, so every build has
#                     them without anyone configuring a dashboard.
#   .env            - gitignored. Everything else, including secrets.
#
# This example file is NOT gitignored, so never put real keys here.
#
# Next reads .env at build time and COMPILES it into the bundle, so a local
# `pnpm cf:deploy` would bake the secrets below into the deployed Worker.
# That does not happen in practice because .env is gitignored and Workers
# Builds never sees it — CI builds from .env.production alone. Deploy through
# Workers Builds, not from this machine.
#
# Production secrets do NOT come from this file. They are set on the Worker:
#   npx wrangler secret put NAME --name hamper-builder
# GITHUB_TOKEN is the example — it exists only as a Worker secret and belongs
# in no env file at all.

# ---------------------------------------------------------------
# REQUIRED — the app will not start without these
# ---------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
#
# These two are compiled into the browser bundle at BUILD time, not read at
# runtime. They are committed in .env.production so every build gets them; set
# them here only to point a local checkout at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# OPTIONAL — GST lookup on the client form
# ---------------------------------------------------------------
# https://www.gstinapi.in -> API Keys. Without it the "Fetch details" button
# says so and the name and address are typed by hand; everything else works.
#
# Keep it here, NOT in .env.production: there is no NEXT_PUBLIC_ prefix, so Next
# keeps it in the server bundle and the browser never sees it — but .env.production
# is committed, and this key spends money. For the deployed Worker set it as a
# secret instead: `npx wrangler secret put GSTIN_API_KEY --name hamper-builder`.
GSTIN_API_KEY=gak_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Local scripts — scripts/sql.mjs, scripts/apply-migrations.mjs
# ---------------------------------------------------------------
# Supabase personal access token: https://supabase.com/dashboard/account/tokens
# The publishable key above is RLS-scoped and cannot create tables, which is why
# this is separate. Account-level: it reaches every project you own and bypasses
# RLS entirely, so give it an expiry and rotate it if it is ever printed.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------
# Account id, shown on the right of any Workers & Pages page. The Worker and the
# R2 bucket live in this account; `wrangler r2` resolves the bucket against it,
# so a stale id fails every upload with a confusing auth error rather than a
# "wrong account" one.
CLOUDFLARE_ACCOUNT_ID=your-account-id

# API token: dashboard -> API Tokens -> Create Token.
#
# It needs "Workers R2 Storage Write" scoped to the ENTIRE ACCOUNT, or scoped to
# the bucket as an R2 token. A token whose resource is a Worker will authenticate
# and then 403 on every bucket call, because permission and resource are separate
# axes and the resource is what blocks it — an easy hour to lose.
#
# publish:desktop is the only thing that reads it, and that is just two
# `wrangler r2 object put` calls, so Workers permissions are not required here.
# Local `wrangler deploy` uses your OAuth login (`wrangler login`) instead, and
# production deploys use the token Workers Builds creates for itself.
#
# The same value must also be set as a GitHub repo secret named
# CLOUDFLARE_API_TOKEN (Settings -> Secrets and variables -> Actions). That is
# the copy .github/workflows/desktop.yml reads; this file never reaches CI.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ---------------------------------------------------------------
# R2 — not used by anything yet
# ---------------------------------------------------------------
# S3-compatible credentials from R2 -> Manage R2 API Tokens. Nothing in this
# app reads them today; they are here so the names are settled if we add
# object storage later (stored quotation PDFs would be the obvious use).
#
# These are NOT interchangeable with CLOUDFLARE_API_TOKEN above. Creating an R2
# token gives you four values: a token value plus these three. Only the token
# value works with `wrangler r2`; the Access Key ID and Secret are for S3
# clients, and the Secret is a hash of the token value, so the token cannot be
# recovered from them.
#
# Note these are for reaching R2 from OUTSIDE the Worker — a local script, a
# backup job, an S3 client. Code running IN the Worker should never use them:
# a bucket is attached as a binding in wrangler.jsonc and read as env.BUCKET,
# with no keys involved and nothing secret to leak. Same for the OpenNext
# incremental cache, which takes a binding rather than S3 credentials.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
