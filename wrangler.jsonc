{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamper-builder",

  // Wraps .open-next/worker.js, built by `opennextjs-cloudflare build`, which
  // turns .next into a Worker. Deploying .next directly does not work, which is
  // why wrangler kept trying to migrate the project on every build. The wrapper
  // serves /updates/* straight from R2 (see worker.mjs).
  "main": "worker.mjs",

  "compatibility_date": "2026-09-03",

  // Required by OpenNext and by @supabase/ssr, both of which use node: builtins.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // The Windows installer and latest.json, served by /updates/<file>. Too big (117 MB) for static
  // assets, which cap at 25 MiB. Upload with `pnpm publish:desktop`.
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "lattice-lane-downloads" }
  ],

  "observability": {
    "enabled": true
  }
}
