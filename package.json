{
  "name": "lattice-lane",
  "version": "0.2.4",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3015",
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "start": "next start -p 3015",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:desktop": "node scripts/build-desktop.mjs",
    "publish:desktop": "wrangler r2 object put lattice-lane-downloads/Lattice-Lane-Setup.exe --file dist/Lattice-Lane-Setup.exe --content-type application/octet-stream --remote && wrangler r2 object put lattice-lane-downloads/latest.json --file dist/latest.json --content-type application/json --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "konva": "^10.5.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@11.9.0",
  "build": {
    "appId": "com.latticelane.hamperbuilder",
    "productName": "Lattice Lane",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lattice Lane",
      "artifactName": "Lattice-Lane-Setup.exe"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!.env"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      }
    ]
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        ".open-next/**"
      ]
    }
  }
}
